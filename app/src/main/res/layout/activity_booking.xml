<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:layoutDirection="rtl"
    android:background="@color/jobsy_background"
    tools:context=".BookingActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="קביעת תור"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/jobsy_text_primary"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר טיפול"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/jobsy_text_primary"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="24dp">
        <Spinner
            android:id="@+id/spinnerTreatments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingHorizontal="16dp"/>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickDate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="בחר תאריך"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        android:textColor="@color/jobsy_primary"
        app:backgroundTint="@color/jobsy_primary_soft"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvSelectedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="תאריך נבחר: --"
        android:textColor="@color/jobsy_text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שעות פנויות"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/jobsy_text_primary"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvNoSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="אין תורים פנויים לתאריך זה"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="@color/jobsy_error"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTimeSlots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="אשר הזמנה"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/jobsy_cta"
        android:textColor="@color/white"
        android:enabled="false"
        android:layout_marginTop="16dp"/>

</LinearLayout>