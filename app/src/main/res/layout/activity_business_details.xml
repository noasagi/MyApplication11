<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="שם העסק"
                android:textColor="@color/textColor"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="סוג העסק"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:layout_marginHorizontal="24dp"
                android:background="#D7CCC8" /> <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="טלפון ליצירת קשר:"
                android:textColor="@color/textColor"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDetailPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="050-0000000"
                android:textSize="18sp"
                android:textColor="@color/colorPrimaryDark"
                android:autoLink="phone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="אודות העסק:"
                android:textColor="@color/textColor"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="תיאור העסק..."
                android:textColor="@color/textColor"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="24dp"
                android:text="שלח הודעה ב-WhatsApp"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@android:drawable/stat_sys_speakerphone"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                android:backgroundTint="#25D366"
                app:cornerRadius="30dp"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnAddReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="דרג את העסק"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="24dp"
                android:backgroundTint="@color/colorAccent"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#D7CCC8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ביקורות אחרונות"
                android:textColor="@color/textColor"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviewsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#D7CCC8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="גלריית תמונות"
                android:textColor="@color/textColor"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/galleryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnFavorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:src="@android:drawable/btn_star_big_off"
        app:tint="@color/colorPrimary"
        app:backgroundTint="@android:color/white"
        android:contentDescription="הוסף למועדפים" />

</FrameLayout>