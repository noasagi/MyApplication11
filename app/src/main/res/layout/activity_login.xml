<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jobsy_background"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ברוכים השבים"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/jobsy_text_primary"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="40dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/eTEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="אימייל"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/eTPass"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="סיסמה"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <CheckBox
            android:id="@+id/cBStayConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="הישאר מחובר"
            android:textColor="@color/jobsy_text_secondary"
            android:buttonTint="@color/jobsy_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginUser"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="התחברות"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jobsy_primary"
            app:cornerRadius="16dp"
            android:layout_marginTop="32dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

        <TextView
            android:id="@+id/tVMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/jobsy_error"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="עוד לא רשום? הירשם עכשיו"
            android:textColor="@color/jobsy_primary"
            android:background="@android:color/transparent"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>