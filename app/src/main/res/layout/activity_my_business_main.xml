<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/business_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA"
    tools:context=".MyBusinessMainActivity">

    <TextView
        android:id="@+id/tVTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="העסק שלי"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imgBusinessMain"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:background="#E0E0E0"
        android:scaleType="centerCrop"
        android:contentDescription="תמונת העסק"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tVTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnChooseImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר תמונה"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imgBusinessMain"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/eTBusinessName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="שם העסק"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnChooseImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/eTBusinessPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="טלפון ליצירת קשר"
        android:inputType="phone"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/eTBusinessName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- תווית לסוג העסק -->
    <TextView
        android:id="@+id/tVBusinessTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="סוג העסק"
        android:layout_marginTop="12dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/eTBusinessPhone"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- שדה חיפוש עם השלמה אוטומטית לסוג העסק -->
    <AutoCompleteTextView
        android:id="@+id/autoBusinessType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="בחר/י סוג עסק"
        android:inputType="text"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tVBusinessTypeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/eTBusinessDescription"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="תיאור העסק"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:minLines="4"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/autoBusinessType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSaveBusiness" />

    <Button
        android:id="@+id/btnSaveBusiness"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="שמור את העסק"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
