<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/business_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/backgroundColor"
    tools:context=".MyBusinessMainActivity">

    <TextView
        android:id="@+id/tVTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ניהול העסק שלי"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/textColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPhotosLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="תמונות העסק"
        android:textSize="14sp"
        android:textColor="@color/colorPrimaryDark"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tVTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <HorizontalScrollView
        android:id="@+id/hsvImages"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginTop="8dp"
        android:background="#EFEBE9"
        app:layout_constraintTop_toBottomOf="@id/tvPhotosLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/previewContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvNoImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לא נבחרו תמונות"
                android:textColor="#9E9E9E"
                android:layout_margin="16dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnChooseImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר מהגלריה"
        android:backgroundTint="@color/colorAccent"
        android:textColor="#FFFFFF"
        app:cornerRadius="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/hsvImages"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTakePhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:text="צלם תמונה"
        android:backgroundTint="@color/colorAccent"
        android:textColor="#FFFFFF"
        app:cornerRadius="20dp"
        app:layout_constraintStart_toEndOf="@+id/btnChooseImage"
        app:layout_constraintTop_toBottomOf="@+id/hsvImages" />

    <EditText
        android:id="@+id/eTBusinessName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="שם העסק"
        android:padding="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/textColor"
        android:textColorHint="#9E9E9E"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnChooseImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/eTBusinessPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="טלפון ליצירת קשר"
        android:inputType="phone"
        android:padding="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/textColor"
        android:textColorHint="#9E9E9E"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/eTBusinessName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tVBusinessTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="סוג העסק"
        android:textColor="@color/textColor"
        android:layout_marginTop="12dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/eTBusinessPhone"
        app:layout_constraintStart_toStartOf="parent" />

    <AutoCompleteTextView
        android:id="@+id/autoBusinessType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="בחר/י סוג עסק"
        android:inputType="text"
        android:padding="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/textColor"
        android:textColorHint="#9E9E9E"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tVBusinessTypeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/eTBusinessDescription"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="תיאור העסק"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:minLines="4"
        android:padding="12dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/textColor"
        android:textColorHint="#9E9E9E"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/autoBusinessType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonsContainer" />

    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDeleteBusiness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="מחק עסק"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            app:cornerRadius="24dp"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnManageHours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="שעות פעילות"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            app:cornerRadius="24dp"
            android:layout_marginEnd="8dp"/>


        <Button
            android:id="@+id/btnSaveBusiness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="שמור עסק"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>