<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jobsy_background"
    android:layoutDirection="rtl"
    tools:context=".MyBusinessMainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/jobsy_background"
        app:title=""
        app:contentInsetStartWithNavigation="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ניהול העסק שלי"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/jobsy_text_primary" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvPhotosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="תמונות העסק"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/jobsy_text_primary"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E2E8F0"
                android:layout_marginBottom="16dp">

                <HorizontalScrollView
                    android:id="@+id/hsvImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/previewContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvNoImages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="לא נבחרו תמונות"
                            android:textColor="@color/jobsy_text_secondary"/>
                    </LinearLayout>
                </HorizontalScrollView>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseImage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="בחר מהגלריה"
                    app:backgroundTint="@color/jobsy_primary_soft"
                    android:textColor="@color/jobsy_primary"
                    app:cornerRadius="12dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="צלם תמונה"
                    app:backgroundTint="@color/jobsy_primary_soft"
                    android:textColor="@color/jobsy_primary"
                    app:cornerRadius="12dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="שם העסק"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTBusinessPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="טלפון ליצירת קשר"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <AutoCompleteTextView
                    android:id="@+id/autoBusinessType"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="סוג עסק (מספרה, קוסמטיקה...)"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTBusinessAddress"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="כתובת העסק (לדוגמה: ויצמן 10, כפר סבא)"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="24dp">
                <EditText
                    android:id="@+id/eTBusinessDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:hint="תיאור העסק"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageHours"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="נהל שעות פעילות"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                android:textColor="@color/jobsy_primary"
                app:backgroundTint="@color/jobsy_primary_soft"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/buttonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteBusiness"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="מחק עסק"
                    app:backgroundTint="#FEE2E2"
                    android:textColor="@color/jobsy_error"
                    app:cornerRadius="16dp"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveBusiness"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="2"
                    android:text="שמור שינויים"
                    app:backgroundTint="@color/jobsy_primary"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>