<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jobsy_background"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="יצירת חשבון"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/jobsy_text_primary"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/eTEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="אימייל"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg"
            android:layout_marginBottom="32dp">
            <EditText
                android:id="@+id/eTPass"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="סיסמה"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tVTypeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אני רוצה להצטרף כ:"
            android:textColor="@color/jobsy_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rbBusiness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="בעל עסק (נותן שירות)"
                android:textColor="@color/jobsy_text_primary"
                android:buttonTint="@color/jobsy_primary"
                android:layout_marginBottom="12dp"/>

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לקוח (מחפש שירות)"
                android:textColor="@color/jobsy_text_primary"
                android:buttonTint="@color/jobsy_primary"/>
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createUser"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="צור משתמש"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jobsy_primary"
            app:cornerRadius="16dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

        <TextView
            android:id="@+id/tVMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/jobsy_error"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>