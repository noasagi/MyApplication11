<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jobsy_background"
    android:layoutDirection="rtl"
    tools:context=".SetProfileActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="הפרופיל שלי"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/jobsy_text_primary"
        android:paddingTop="24dp"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="#E2E8F0"
                    android:clickable="true"
                    android:focusable="true"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לחץ להוספת תמונה"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/jobsy_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="שם מלא"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="תאריך לידה"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/eTAddress"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="כתובת"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jobsy_card_bg"
                android:layout_marginBottom="32dp">
                <EditText
                    android:id="@+id/eTPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="טלפון"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:background="@null"
                    android:textColor="@color/jobsy_text_primary"
                    android:textColorHint="@color/jobsy_text_secondary"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="שמור פרופיל"
                app:backgroundTint="@color/jobsy_primary"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <TextView
                android:id="@+id/tVMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/jobsy_error"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>