<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/jobsy_background"
    android:layoutDirection="rtl"
    tools:context=".BusinessServicesFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="הוספת טיפול חדש"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="@color/jobsy_text_primary"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/jobsy_card_bg"
        android:layout_marginBottom="16dp">
        <EditText
            android:id="@+id/etTreatmentName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="שם הטיפול (לדוגמה: תספורת)"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:background="@null"
            android:textColor="@color/jobsy_text_primary"
            android:textColorHint="@color/jobsy_text_secondary"
            android:textSize="16sp"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg">
            <EditText
                android:id="@+id/etTreatmentDuration"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="זמן (בדקות)"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/jobsy_card_bg">
            <EditText
                android:id="@+id/etTreatmentPrice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="מחיר (₪)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:background="@null"
                android:textColor="@color/jobsy_text_primary"
                android:textColorHint="@color/jobsy_text_secondary"
                android:textSize="16sp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTreatment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="הוסף טיפול"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        android:textColor="@color/white"
        app:backgroundTint="@color/jobsy_cta"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_marginBottom="32dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="הטיפולים שלי"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@color/jobsy_text_primary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTreatments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>