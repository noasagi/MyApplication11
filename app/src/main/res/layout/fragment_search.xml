<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jobsy_background"
    android:layoutDirection="rtl"
    tools:context=".SearchFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="חיפוש עסקים"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/jobsy_text_primary"
        android:padding="24dp"
        android:background="@color/jobsy_background"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/jobsy_card_bg">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:iconifiedByDefault="false"
            app:queryHint="חפש לפי שם העסק..."
            app:searchIcon="@android:drawable/ic_menu_search"
            android:theme="@style/JobsySearchViewTheme"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סנן לפי:"
            android:textColor="@color/jobsy_text_primary"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"/>

        <Spinner
            android:id="@+id/spinnerCategories"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/jobsy_card_bg"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNearMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="קרוב אליי (עד 15 ק״מ)"
            android:textColor="@color/jobsy_text_primary"
            android:textSize="16sp"
            app:useMaterialThemeColors="true"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBusinesses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="לא נמצאו עסקים תואמים"
            android:visibility="gone"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:textColor="@color/jobsy_text_secondary"/>

    </FrameLayout>

</LinearLayout>