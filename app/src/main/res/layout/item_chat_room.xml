<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/rounded_background"
    android:layoutDirection="rtl">

    <androidx.cardview.widget.CardView
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/imgChatProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="#F5F5F5"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvChatClientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="טוען נתונים..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/jobsy_text_primary"/>

        <TextView
            android:id="@+id/tvChatLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הודעה אחרונה"
            android:textSize="14sp"
            android:textColor="@color/jobsy_text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>