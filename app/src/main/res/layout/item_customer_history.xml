<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/jobsy_card_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/jobsy_text_secondary"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryBusinessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="טוען..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/jobsy_text_primary"/>

            <TextView
                android:id="@+id/tvHistoryDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="תאריך ושעה"
                android:textSize="14sp"
                android:textColor="@color/jobsy_text_secondary"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvHistoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הושלם"
                android:textSize="12sp"
                android:textColor="#10B981"
                android:layout_marginTop="4dp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryBookAgain"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="הזמן שוב"
            android:textSize="12sp"
            app:backgroundTint="@color/jobsy_primary_soft"
            android:textColor="@color/jobsy_primary"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>