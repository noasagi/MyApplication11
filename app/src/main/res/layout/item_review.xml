<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="16dp"
    app:cardBackgroundColor="@color/jobsy_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layoutDirection="rtl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvReviewerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שם המדרג"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/jobsy_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvReviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12/05/2024"
            android:textSize="12sp"
            android:textColor="@color/jobsy_text_secondary"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReviewerName"/>

        <RatingBar
            android:id="@+id/rbReviewRating"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="4.5"
            android:stepSize="0.1"
            android:isIndicator="true"
            android:progressTint="#FFB300"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvReviewDate"/>

        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="היה שירות מצוין, ממליץ מאוד!"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/jobsy_text_primary"
            app:layout_constraintTop_toBottomOf="@id/tvReviewDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>